{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "import", "unicorn", "vitest"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "ignorePatterns": ["dist", ".scratch", ".claude"],
    "rules": {
        "react/react-in-jsx-scope": "off"
    }
}

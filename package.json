{
    "name": "chronoscribe",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "e2e": "playwright test",
        "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && vite build",
        "prepare": "git config core.hooksPath .githooks"
    },
    "dependencies": {
        "@tanstack/react-virtual": "3.14.21",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "comlink": "^4.4.2",
        "d3-scale": "^4.0.2",
        "d3-selection": "^3.0.0",
        "d3-shape": "^3.2.0",
        "d3-zoom": "^3.0.0",
        "dexie": "^4.4.7",
        "lucide-react": "^1.55.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "zod": "4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-selection": "^3.0.11",
        "@types/d3-shape": "^3.1.7",
        "@types/d3-zoom": "^3.0.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "fake-indexeddb": "^6.2.6",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@11.8.0"
}
